{
  "name": "printcost-cl",
  "productName": "PrintCost CL",
  "version": "1.0.0",
  "description": "Calculadora de Precios y Cotizaciones de Impresión 3D en Pesos Chilenos (CLP)",
  "homepage": "https://suenos3d.cl",
  "author": "Sueños 3D <contacto@suenos3d.cl>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && ELECTRON_RUN_AS_NODE= electron . --no-sandbox",
    "start": "vite build && ELECTRON_RUN_AS_NODE= electron . --no-sandbox",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:all": "vite build && electron-builder -mwl"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "cl.suenos3d.calculadora",
    "productName": "Sueños 3D",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "executableName": "suenos-3d",
      "maintainer": "Sueños 3D <contacto@suenos3d.cl>",
      "target": [
        "AppImage"
      ]
    }
  }
}
